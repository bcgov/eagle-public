{
  "name": "eagle-public",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck:e2e": "tsc --noEmit -p e2e",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" vite.config.ts eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" vite.config.ts eslint.config.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  },
  "private": true,
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.0"
  },
  "dependencies": {
    "@analytics/original-source-plugin": "^1",
    "@microsoft/applicationinsights-web": "^3.4.3",
    "@tanstack/react-query": "^5",
    "@vis.gl/react-maplibre": "^8",
    "analytics": "^0.8",
    "bootstrap": "^5",
    "dompurify": "^3.4.14",
    "luxon": "^3",
    "maplibre-gl": "^6",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vite": "^8",
    "vitest": "^4"
  }
}
