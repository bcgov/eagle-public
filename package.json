{
  "name": "eagle-public",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.0"
  },
  "dependencies": {
    "@analytics/original-source-plugin": "^1.0.15",
    "@angular/animations": "^21.0.8",
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.0.8",
    "@angular/compiler": "^21.0.8",
    "@angular/core": "^21.0.8",
    "@angular/forms": "^21.0.8",
    "@angular/localize": "^21.0.8",
    "@angular/platform-browser": "^21.0.8",
    "@angular/router": "^21.0.8",
    "@babel/runtime": "^7.29.2",
    "@ng-bootstrap/ng-bootstrap": "20.0.0",
    "@popperjs/core": "^2.11.8",
    "analytics": "^0.8.14",
    "bootstrap": "^5.3.8",
    "instantsearch.js": "^4.73.0",
    "luxon": "^3.7.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typesense-instantsearch-adapter": "^2.7.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.1",
    "@analogjs/vitest-angular": "^2.2.2",
    "@angular-eslint/builder": "21.1.0",
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.8",
    "@angular/platform-browser-dynamic": "^21.0.8",
    "@eslint/js": "^9.39.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/luxon": "^3.7.1",
    "@vitest/coverage-v8": "^4.0.16",
    "angular-eslint": "21.1.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.47.0",
    "vitest": "^4.0.16"
  }
}
