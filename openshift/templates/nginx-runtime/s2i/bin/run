#!/bin/bash
echo "Starting nginx-runtime..."

# Set defaults
export DEPLOYMENT_ENVIRONMENT=${DEPLOYMENT_ENVIRONMENT:-dev}
export BANNER_COLOUR=${BANNER_COLOUR:-blue}

# Set analytics API URL based on environment
case "$DEPLOYMENT_ENVIRONMENT" in
    prod) export ANALYTICS_API_URL=${ANALYTICS_API_URL:-/api/analytics} ;;
    test) export ANALYTICS_API_URL=${ANALYTICS_API_URL:-/api/analytics} ;;
    *)    export ANALYTICS_API_URL=${ANALYTICS_API_URL:-/api/analytics} ;;
esac

# Generate publicServerEnvironmentSettings.js from template
if [ -f /tmp/publicServerEnvironmentSettings.js.template ]; then
    sed "s~\${DEPLOYMENT_ENVIRONMENT}~${DEPLOYMENT_ENVIRONMENT}~g; \
         s~\${BANNER_COLOUR}~${BANNER_COLOUR}~g; \
         s~\${ANALYTICS_API_URL}~${ANALYTICS_API_URL}~g" \
        /tmp/publicServerEnvironmentSettings.js.template > /etc/nginx/publicServerEnvironmentSettings.js
    echo "Environment: ${DEPLOYMENT_ENVIRONMENT}, Analytics: ${ANALYTICS_API_URL}"
fi

# Process nginx.conf template
if [ -f /tmp/nginx.conf.template ]; then
    sed "s~%RealIpFrom%~${RealIpFrom:-172.51.0.0/16}~g; \
         s~%IpFilterRules%~${IpFilterRules}~g; \
         s~%AdditionalRealIpFromRules%~${AdditionalRealIpFromRules}~g" \
        /tmp/nginx.conf.template > /etc/nginx/nginx.conf
fi

# HTTP basic auth (if configured)
if [ -n "$HTTP_BASIC_USERNAME" ] && [ -n "$HTTP_BASIC_PASSWORD" ]; then
    echo "$HTTP_BASIC_USERNAME:$(openssl passwd -crypt $HTTP_BASIC_PASSWORD)" > /tmp/.htpasswd
fi

exec /usr/sbin/nginx -g "daemon off;"
