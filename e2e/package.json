{
  "name": "eagle-public-e2e",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "test": "sh -c '[ -n \"$BASE_URL\" ] && playwright test || echo \"e2e: set BASE_URL to run the parity suite\"'",
    "baseline": "BASELINE_WRITE=1 playwright test --workers=1",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
